# ==============================================================================
# Enterprise News Lakehouse — Variáveis de Ambiente (.env.example)
# Copie para .env e substitua pelos segredos reais fora do controle de versão.
# ==============================================================================

# Timezone padrão dos serviços (persistência analítica ocorre sempre em UTC)
TZ=America/Sao_Paulo

# --- Serviços Legados / Existentes no Compose (Preservados) ---
RABBITMQ_USER=celery_news
RABBITMQ_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=SUBSTITUA_POR_USUARIO_RUSTFS
AWS_SECRET_ACCESS_KEY=SUBSTITUA_POR_SENHA_RUSTFS
RUSTFS_CONSOLE_ENABLE=true
GRAFANA_ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# --- Serviços Exclusivos Enterprise News Lakehouse (enl_*) ---
ENL_RABBITMQ_USER=enl_usuario
ENL_RABBITMQ_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_ENL_RABBITMQ
ENL_RABBITMQ_VHOST=enl_vhost
ENL_RABBITMQ_PORT=5673
ENL_RABBITMQ_MGMT_PORT=15673

ENL_POSTGRES_USER=enl_postgres
ENL_POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_ENL_POSTGRES
ENL_POSTGRES_DB=enl_operacional
ENL_POSTGRES_PORT=5433

ENL_STORAGE_ACCESS_KEY=SUBSTITUA_POR_CHAVE_STORAGE_ENL
ENL_STORAGE_SECRET_KEY=SUBSTITUA_POR_SEGREDO_STORAGE_ENL
ENL_STORAGE_REGION=us-east-1
ENL_STORAGE_PORT=9010
ENL_STORAGE_CONSOLE_PORT=9011

